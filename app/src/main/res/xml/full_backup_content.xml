<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves this device by backup: the app holds Home Assistant webhook ids, which are
    credentials, and every setting is cheap to redo. `android:allowBackup` is already false; this is the
    same statement in the form Android 11 and below read, beside `data_extraction_rules.xml` for 12+.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
